{
  "expo": {
    "name": "RED",
    "slug": "red-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1015",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddiscovery.app"
    },
    "android": {
      "package": "com.reddiscovery.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f1015"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f1015"
        }
      ]
    ],
    "scheme": "redapp",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3820470e-766d-4f25-9b9a-96fabb130b46"
      }
    }
  }
}