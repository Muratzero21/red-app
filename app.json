{
  "expo": {
    "name": "RED",
    "slug": "red-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1015",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddiscovery.app"
    },
    "android": {
      "package": "com.reddiscovery.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f1015"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image"
    ],
    "scheme": "redapp",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2cdb4c9d-8e3e-46b0-bf12-2e405fd5c2e9"
      }
    },
    "owner": "qmorningstar2"
  }
}
